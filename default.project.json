{
  "name": "roblox_game_template",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Client": {
        "$className": "Folder",
        "Game": {
          "$className": "Folder",
          "Main": {
            "$path": {
              "optional": "dist/Game/Main.client.luau"
            }
          },
          "$ignoreUnknownInstances": false
        },
        "$ignoreUnknownInstances": false
      },
      "Packages": {
        "$path": "packages/roblox"
      },
      "Shared": {
        "$className": "Folder",
        "Features": {
          "$path": {
            "optional": "dist/Features"
          }
        },
        "Platform": {
          "$path": {
            "optional": "dist/Platform"
          }
        },
        "$ignoreUnknownInstances": false
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Core": {
        "$className": "Folder",
        "Data": {
          "$className": "Folder",
          "DataService": {
            "$path": {
              "optional": "dist/Core/Data/DataService@Server.luau"
            }
          },
          "$ignoreUnknownInstances": false
        },
        "$ignoreUnknownInstances": false
      },
      "Game": {
        "$className": "Folder",
        "Main": {
          "$path": {
            "optional": "src/Game/Main.server.luau"
          }
        },
        "$ignoreUnknownInstances": false
      }
    }
  },
  "emitLegacyScripts": false
}